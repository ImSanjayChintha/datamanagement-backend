# Application
APP_NAME="CorexStack Ecommerce"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=change-me-to-a-very-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_secret
POSTGRES_DB=ecommerce
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ecom:ecom_secret@db:5432/ecommerce

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Typesense
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=ts_dev_key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PRODUCTS=product-images
MINIO_BUCKET_DOCS=product-docs
MINIO_USE_SSL=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=smtp_password
EMAILS_FROM=noreply@example.com

# Sentry (optional)
SENTRY_DSN=
